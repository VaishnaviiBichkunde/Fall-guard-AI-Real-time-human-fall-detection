# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=fall_guard_ai

# Email Notification Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_EMAIL=your_email@gmail.com
DEFAULT_CAREGIVER_EMAIL=caregiver@example.com

# System Settings
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
APP_URL=http://localhost:8501
API_URL=http://localhost:8000
DATA_RETENTION_DAYS=90
CARETAKER_RESPONSE_TIMEOUT_SECONDS=30
